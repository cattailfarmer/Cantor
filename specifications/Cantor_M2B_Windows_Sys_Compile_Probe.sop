& [AuthorizedFileSet] is exact
  + [dependency_file] is crates/cantor_ecosystem/Cargo.toml
  + [probe_file] is crates/cantor_ecosystem/tests/windows_topology_abi_probe.rs
  + [governance_files] are source, canonical, exploded, justification, plan, matrix, slice, registry, solution, proof, evidence, fault, file-change, turn, and completion-review records
  + [Cargo_lock] is verification input and must not change
  - never: edit production Rust source or lib.rs

& [DependencyContract] is exact
  + [target] is cfg(windows)
  + [package] is windows-sys
  + [version] is =0.61.2
  + [default_features] is false
  + [features] are exactly Win32_Foundation, Win32_Security, and Win32_Storage_FileSystem
  + [checksum] is ae137229bcbd6cdf0f7b80a31df61766145077ddf49416a728b02cb3921ff3fc
  + [license] is MIT OR Apache-2.0
  + [lock_sha256_before] is 7b2e1e879e387ccff1cf1e04de4ace1d72eb006d1443192ab26629f0c3a884a5
  + [required_lock_sha256_after] is 7b2e1e879e387ccff1cf1e04de4ace1d72eb006d1443192ab26629f0c3a884a5

& [ProbeContract] is no-call
  + [cfg] is windows
  + [profile] is cantor-windows-topology-abi-probe/0.1
  + [function_items] are CreateFileW, GetFileInformationByHandleEx, GetFinalPathNameByHandleW, GetVolumeInformationByHandleW, and GetLastError
  + [operation] is reference each function item as a value without invocation or address cast
  + [structures] are FILE_ATTRIBUTE_TAG_INFO, FILE_CASE_SENSITIVE_INFO, FILE_ID_INFO, FILE_STANDARD_INFO, FILE_STREAM_INFO, and FILE_REMOTE_PROTOCOL_INFO
  + [structure_operation] is size_of and align_of
  + [machine_fingerprint] is deterministic in-memory JSON compared to one exact expected string
  - never: use an imported function call expression
  - never: create, initialize, transmute, dereference, or parse a generated structure

& [ClassContract] is exact
  + [FileStandardInfo] is 1
  + [FileStreamInfo] is 7
  + [FileAttributeTagInfo] is 9
  + [FileRemoteProtocolInfo] is 13
  + [FileIdInfo] is 18
  + [FileCaseSensitiveInfo] is 23

& [PolicyConstantContract] is read-only
  + [OPEN_EXISTING] is 3
  + [share] is FILE_SHARE_READ 1 plus FILE_SHARE_WRITE 2 plus FILE_SHARE_DELETE 4
  + [flags] are FILE_FLAG_BACKUP_SEMANTICS 33554432 and FILE_FLAG_OPEN_REPARSE_POINT 2097152
  + [attributes] include NORMAL 128, SPARSE_FILE 512, and REPARSE_POINT 1024
  + [access] includes FILE_READ_ATTRIBUTES and FILE_GENERIC_READ for numeric inspection
  + [write_guard] FILE_GENERIC_READ must have zero intersection with FILE_WRITE_DATA and FILE_WRITE_ATTRIBUTES
  + [path_flags] are FILE_NAME_NORMALIZED and VOLUME_NAME_GUID

& [RequirementSet] is M2B-ABI-001 through M2B-ABI-010
  + [M2B-ABI-001] is exact source and research lineage
  + [M2B-ABI-002] is exact target dependency and features
  + [M2B-ABI-003] is byte-identical lock and unchanged package count
  + [M2B-ABI-004] is five generated function items compiled without calls
  + [M2B-ABI-005] is six generated structure sizes and alignments
  + [M2B-ABI-006] is six exact information-class codes
  + [M2B-ABI-007] is exact observation constants and write-access absence
  + [M2B-ABI-008] is deterministic in-memory fingerprint
  + [M2B-ABI-009] is zero unsafe, call, production API, and physical effect surface
  + [M2B-ABI-010] is global proof, evidence, audit, rollback, registry, and support closure

& [StaticGuards] are required
  + [unsafe_token] is absent from the test
  + [call_expression] is absent for every imported Windows function
  + [production_delta] is absent
  + [Cargo_scope] is only the closed dependency table
  + [lock_delta] is absent
  + [forbidden_constant] is no create, truncate, delete, write-data, write-attributes, or generic-write value used as an authorized mask

& [Acceptance] is exact
  + [focused] Windows probe compiles, links, and passes
  + [fingerprint] exact machine JSON matches
  + [dependency] cargo tree shows cantor_ecosystem as a direct windows-sys consumer with the declared features
  + [lock] SHA-256 and dependency count remain exact
  + [global] debug, overflow-checked release, lint, build, rustdoc, and audit pass
  + [evidence] current and affected predecessor manifests are clone-portable

& [AuthorityBoundary] is compile-only
  + [allowed] is exact Cargo dependency declaration, one cfg(windows) integration test, deterministic assertions, evidence generation, and proof
  + [forbidden] is FFI invocation, unsafe, production wrapper, public runtime API, path, handle, filesystem, clock, random, environment, process, network, model, fixture, candidate, sandbox, mutation, seal, cleanup, launch, or promotion

& [SJSProcessingTrace] is complete
  + [source_preserved] is exact source and research manifest
  + [delineated] is dependency/ABI availability separated from runtime call authority
  + [exploded] is ten atomic requirements, ten constraints, seven failure modes, and eight verification steps
  + [semantically_refined] is exact package, feature, function, structure, class, constant, call, and nonclaim meaning
  + [constraint_checked] is source, lock, generated source, prior review, and completed-work grounding
  + [pruned] is production wrapper, FFI call, fixture, broad feature set, and platform overclaim
  + [data_design_checked] is dependency and ABI identity with deterministic fingerprint projection
  + [exhaustion_reviewed] is seven_fold_phase_locked
  + [justified] is claim, support, confidence, counterargument, invalidation, and rollback
  + [planned] is ordered implementation and verification
  + [registry_recorded] is complete node and edge lineage

