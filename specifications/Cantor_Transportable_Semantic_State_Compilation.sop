  + [source_manifest] is C:\Project\Cantor\source_documents\2026-07-29_cantor_transportable_semantic_state\Source_Document_Manifest.sop
  + [processed_stage_set] is source_preserved, neural_state_excluded, portable_state_formed, organization_grammar_formed, query_compiler_formed, resolution_contract_formed, semantic_density_bounded, justified, and signed
  + [signature_status] is valid_for_transportable_semantic_state_formation
  + [implementation_authority] is limited_to_transportable_state_query_plan_and_equivalence_records_inside_the_existing_bounded_CoreAcceptance_fixtures

