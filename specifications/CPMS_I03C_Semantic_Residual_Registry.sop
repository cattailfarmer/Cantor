  + roots all; subjects ProcedureBounds ProcedureType ProcedureValue CantorProcessIr; stage semantic_validation
  + procedure_validation validate_bounds validate_type_with_bounds validate_value_with_bounds
  + enforced safe_pure release_blocking; maximum_call_depth is no greater than 64 and every bound is positive

