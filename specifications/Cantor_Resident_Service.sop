  + [processed_stage_set] is source_preserved, prerequisites_verified, boundary_formed, data_formed, transport_bounded, refresh_governed, recovery_formed, requirements_mapped, justified, and signed
  + [signature_status] is valid_for_bounded_resident_service_implementation
  + [implementation_authority] is cantor_service_cantord_cantorctl_and_minimal_shared_core_preflight_only
