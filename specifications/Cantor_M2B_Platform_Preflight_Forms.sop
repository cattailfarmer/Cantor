  + [source_preserved] is Source_Document_Manifest.sop
  + [delineated] is exploded BoundaryFormation
  + [exploded] is Cantor_M2B_Platform_Preflight_Forms.exploded.sop
  + [semantically_refined] is exploded SemanticRefinementTrace
  + [constraint_checked] is exploded ConstraintLedger and ConstraintCheckTrace
  + [pruned] is exploded PruningTrace
